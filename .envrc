if ! has nix_direnv_version || ! nix_direnv_version 3.0.6; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.6/direnvrc" "sha256-RYcUJaRMf8oF5LznDrlCXbkOQrywm0HDv1VjYGaJGdM="
fi

export DEVENV_ROOT="$PWD"

# The API/WebDAV suites start their throwaway Postgres + Azurite with
# `docker compose` (tests/common/spawn-db.sh). Without access to the Docker
# daemon socket, fall back to a rootless Podman socket if one is running.
podman_sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
if [ -z "${DOCKER_HOST:-}" ] && [ ! -w /var/run/docker.sock ] && [ -S "$podman_sock" ]; then
  export DOCKER_HOST="unix://$podman_sock"
fi
unset podman_sock

use flake "path:$PWD" --no-pure-eval --impure
